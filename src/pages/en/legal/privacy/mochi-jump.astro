---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mochi Jump Privacy Policy | tovin Labs"
  description="Privacy policy for the Mochi Jump children's game"
  lang="en"
>
  <article class="px-6 py-16 max-w-3xl mx-auto">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Mochi Jump Privacy Policy</h1>
    <p class="text-[var(--color-fg-muted)] mb-12">
      Last updated: <span data-placeholder>To be set on launch</span>
    </p>

    <p class="text-[var(--color-fg-muted)] leading-relaxed mb-6">
      The full privacy policy will replace this page shortly. Mochi Jump targets children aged
      7–13, and the published policy will include specific provisions for users under 14 and
      under 13 (COPPA).
    </p>

    <p class="text-[var(--color-fg-muted)]">
      Contact: <a href="mailto:privacy@tovinlabs.com" class="text-[var(--color-fg)] underline">
        privacy@tovinlabs.com
      </a>
    </p>
  </article>
</BaseLayout>
