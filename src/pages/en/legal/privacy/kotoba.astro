---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kotoba Privacy Policy | tovin Labs"
  description="Privacy policy for the Kotoba JLPT Japanese learning app"
  lang="en"
>
  <article class="px-6 py-16 max-w-3xl mx-auto">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Kotoba Privacy Policy</h1>
    <p class="text-[var(--color-fg-muted)] mb-12">
      Last updated: <span data-placeholder>To be set on launch</span>
    </p>

    <p class="text-[var(--color-fg-muted)] leading-relaxed mb-6">
      The full privacy policy will replace this page shortly. Kotoba is preparing for launch and
      a detailed policy describing data handling will be published here.
    </p>

    <p class="text-[var(--color-fg-muted)]">
      Contact: <a href="mailto:privacy@tovinlabs.com" class="text-[var(--color-fg)] underline">
        privacy@tovinlabs.com
      </a>
    </p>
  </article>
</BaseLayout>
