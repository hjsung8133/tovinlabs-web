---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kids Policy | tovin Labs"
  description="tovin Labs policy for children under 14 (and COPPA-applicable users under 13)"
  lang="en"
>
  <article class="px-6 py-16 max-w-3xl mx-auto">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Kids Policy</h1>
    <p class="text-[var(--color-fg-muted)] mb-12">
      Last updated: <span data-placeholder>To be set on launch</span>
    </p>

    <p class="text-[var(--color-fg-muted)] leading-relaxed mb-6">
      tovin Labs operates a dedicated policy for users under 14 (and COPPA-applicable users under
      13). The full policy will replace this page shortly.
    </p>

    <p class="text-[var(--color-fg-muted)]">
      Contact: <a href="mailto:privacy@tovinlabs.com" class="text-[var(--color-fg)] underline">
        privacy@tovinlabs.com
      </a>
    </p>
  </article>
</BaseLayout>
